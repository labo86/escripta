{
  "name" : "labo86/action_scripts",
  "autoload" : {
    "psr-4" : {
      "labo86\\action_scripts\\" : "src/"
    },
    "files" : [
        "src/docker.php",
        "src/git.php",
        "src/image.php",
        "src/mySql.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "labo86\\action_scripts\\tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "require" : {
    "php" : ">=8.2.0",
    "ext-curl" : "*",
    "ext-json" : "*"
  }
}